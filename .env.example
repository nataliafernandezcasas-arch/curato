NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
RESEND_API_KEY=your_resend_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phyllo (Instagram follower verification)
PHYLLO_CLIENT_ID=your_phyllo_client_id
PHYLLO_CLIENT_SECRET=your_phyllo_client_secret
PHYLLO_API_URL=https://api.staging.getphyllo.com
NEXT_PUBLIC_PHYLLO_ENV=staging

# PassKit.com (Apple Wallet + Google Wallet for Midi Pass)
# Get these from PassKit dashboard: Account -> Service Accounts -> create JWT
PASSKIT_API_KEY=
PASSKIT_PROGRAM_ID=
PASSKIT_TIER_ID=
PASSKIT_API_URL=https://api.pub2.passkit.io

# Shared secret between midi-pass and midi-crm. Generate with: uuidgen
INTERNAL_API_KEY=

# Shared password to access /admin/*. Anyone with this clave puede entrar.
ADMIN_PASS=

# Con qué se firma la sesión del admin. La cookie ya no guarda la contraseña:
# guarda una firma con caducidad de siete días, así que si se filtra no sirve
# para entrar en ningún otro sitio. Cambiar este valor cierra todas las
# sesiones. Si se deja vacío, se firma con ADMIN_PASS.
# Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# El secreto del webhook de Phyllo, el mismo que se configura en su panel. Sin
# esto el webhook queda cerrado: cualquiera podía marcar una cuenta de
# Instagram como conectada, porque la ruta escribe con permisos de
# administrador. Se acepta en x-phyllo-secret, x-webhook-secret o
# Authorization: Bearer, o como firma HMAC del cuerpo en x-phyllo-signature.
# Generar con: openssl rand -hex 32
PHYLLO_WEBHOOK_SECRET=
